{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "in-direct",
      "port": 8443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "<UUID>",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "127.0.0.1:8444",
          "xver": 0,
          "serverNames": [
            "landing.example.com"
          ],
          "privateKey": "<REALITY_PRIVATE_KEY>",
          "shortIds": [
            "<SHORT_ID>"
          ]
        }
      },
      "sniffing": {
        "enabled": false
      }
    },
    {
      "tag": "in-proton",
      "port": 8445,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "<UUID>",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "127.0.0.1:8444",
          "xver": 0,
          "serverNames": [
            "landing.example.com"
          ],
          "privateKey": "<REALITY_PRIVATE_KEY>",
          "shortIds": [
            "<SHORT_ID>"
          ]
        }
      },
      "sniffing": {
        "enabled": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "proton",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "interface": "warp-vpn"
        }
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "in-proton"
        ],
        "outboundTag": "proton"
      },
      {
        "type": "field",
        "inboundTag": [
          "in-direct"
        ],
        "outboundTag": "direct"
      }
    ]
  }
}